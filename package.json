{
  "name": "local-media-converter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A browser-based local media converter powered by FFmpeg.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --clearScreen false --logLevel error",
    "build": "tsc -b --pretty false && vite build --logLevel error",
    "preview": "vite preview --host 0.0.0.0 --clearScreen false --logLevel error",
    "lint": "eslint . --quiet",
    "format:check": "git ls-files -z | xargs -0 prettier --list-different --ignore-unknown",
    "verify": "npm --silent run build && npm --silent run lint && npm --silent run format:check"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mlc-ai/web-llm": "^0.2.79",
    "@orama/orama": "^3.1.16",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.2.7"
  }
}
